#!/bin/bash
# refresh-templates: regenerate the factory's templates FROM MANYHALLS.
#
# The factory (bin/fort-init + templates/) founds new forts. Its machinery
# templates are not written by hand: they are Manyhalls's own machinery with
# every fort-specific value turned into a fort-init placeholder
# (bin/mk-templates.py), plus a charter, four seat files and a product-gate stub
# derived from Manyhalls's (bin/mk-templates-hand.py). Regent sitting
# 2026-11-18, fortkit-ttpk, docket items T10 to T12.
#
# Run it after Manyhalls's machinery changes and the change should reach new
# forts. Both generators REFUSE when a rule of theirs matches nothing, which
# means the tree moved under them: read the rule, do not delete it.
# bin/ and templates/ are gate-1 surface and kernel read-only to every seat:
# this is Regent work, and the proof is founding a throwaway fort and running
# its verifier (the product-gate stub red, every machinery step green).
#
# usage: bin/refresh-templates          (from anywhere; it writes templates/ in this checkout)
set -euo pipefail
kit="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# The bead export decides which bead ids are the capital's own (kept as
# provenance) and which are data (rendered with the new fort's prefix), so a
# STALE export silently rewrites citations of recent beads. In a worktree the
# tracked export is as old as the branch: pass a fresh one in REFRESH_EXPORT
# (bd export -o <scratch file>, run from the main checkout).
export_file="${REFRESH_EXPORT:-$kit/.beads/issues.jsonl}"
[ -r "$export_file" ] || { echo "refresh-templates: no $export_file (run: bd export -o .beads/issues.jsonl)" >&2; exit 1; }
out="$(mktemp -d)"; trap 'rm -rf "$out"' EXIT
cp "$kit/templates/fort/charter.md" "$out/previous-charter.md"
mkdir "$out/t"
python3 -W error::SyntaxWarning "$kit/bin/mk-templates.py" "$kit" "$out/t" "$export_file"
python3 -W error::SyntaxWarning "$kit/bin/mk-templates-hand.py" "$kit" "$out/t" "$out/previous-charter.md"
# Files the generators own are replaced; files kept by hand in templates/ are left.
( cd "$out/t" && find . -type f | sort ) | while IFS= read -r rel; do
  mkdir -p "$kit/templates/$(dirname "$rel")"
  cp -p "$out/t/$rel" "$kit/templates/$rel"
done
echo "refresh-templates: $(cd "$out/t" && find . -type f | wc -l) template files written under $kit/templates"
echo "refresh-templates: now found a throwaway fort (FORT_REGISTRY at a scratch path) and run its verifier."
