#!/bin/bash
# The Regent — the civilization's break-glass seat.
#
# The forts are built so they cannot fix themselves: their constitutions are
# kernel-read-only, their seats are masked, their privileged operations go
# through an airlock. That is correct, and it means something must be able to
# reach in from outside. This is that something.
#
# The Regent runs UNMASKED with full access to every fort and the machine. It
# has no technical guard. Its safety properties are entirely procedural:
#   - it is invoked deliberately, never on a schedule
#   - it announces itself in EVERY fort's event stream, at start and at end,
#     so no session above the constitution is ever invisible in the record
#   - it keeps its own memory, so it knows what it has done before
#   - its whole transcript is archived
#
# An edict is spoken in the Overseer's name and only while he is present.
#
# Usage: regent [--brief-only] ["opening instruction"]
set -euo pipefail

# Resolve through the symlink at ~/.local/bin/regent, or KIT lands in ~/.local
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
KIT="$(cd "$(dirname "$SELF")/.." && pwd)"
CIV="$KIT/civ"
REG="$HOME/.claude/civilization.json"
mkdir -p "$CIV/handoffs" "$CIV/transcripts"
BRIEF="$CIV/briefing.md"
stamp="$(date +%Y-%m-%dT%H%M%S)"

# ---------------------------------------------------------------- briefing ---
# Generated fresh every wake. A stale briefing is worse than none: it would
# describe a civilization that no longer exists and the Regent would act on it.
{
  echo "# Civilization briefing — generated $(date -Is)"
  echo
  echo "You are the REGENT, a seat of the civilization layer. You act in the Overseer's"
  echo "name, only while he is present, and only for work the settlements cannot do"
  echo "themselves. You are unmasked and unrestricted; every other seat in this"
  echo "civilization is deliberately not. That asymmetry is the reason you exist and the"
  echo "reason to use the least force that solves the problem."
  echo
  # The law is not restated here. It is read from the covenant, so that amending
  # the covenant amends the briefing, and the two can never drift apart. An
  # earlier version paraphrased five standing-conduct bullets inline; that is
  # exactly the duplication that goes stale first and is trusted longest.
  echo "## Your law: civ/covenant.md, reproduced in full"
  echo
  [ -f "$CIV/covenant.md" ] && cat "$CIV/covenant.md"
  echo
  echo "## Your seat: civ/seats/regent.md, reproduced in full"
  echo
  [ -f "$CIV/seats/regent.md" ] && cat "$CIV/seats/regent.md"
  echo
  echo "## The other seats of the civilization layer"
  { ls "$CIV/seats"/*.md 2>/dev/null || true; } | while read -r f; do
    [ "$(basename "$f")" = "regent.md" ] && continue
    echo "- $(basename "$f" .md): $(grep -m1 '^\*\*Role:\*\*' "$f" | sed 's/\*\*Role:\*\* //' | cut -c1-160)"
  done
  echo
  echo "## Settlements"
  jq -r '.forts[] | "- **\(.fort_name // "unnamed")** (\(.project)) — \(.repo), founded \(.founded)"' "$REG" 2>/dev/null
  echo
  for repo in $(jq -r '.forts[].repo' "$REG" 2>/dev/null); do
    name=$(basename "$repo")
    echo "### $name"
    [ -f "$repo/fort/charter.md" ] && { echo "**Human gates and prose gates:**"; sed -n '/^## Human gates/,/^## Standing orders/p' "$repo/fort/charter.md" | grep -E '^[0-9]+\.|^\*\*' | head -12; }
    echo
    echo "**Open beads (top):**"
    (cd "$repo" && bd list 2>/dev/null | grep -E "◐|○" | head -6) || true
    echo
    echo "**Last handoff:** $({ ls -t "$repo"/fort/handoffs/*.md 2>/dev/null || true; } | head -1 | xargs -r basename)"
    echo "**Git:** $(git -C "$repo" log --oneline -1 2>/dev/null) | ahead of origin: $(git -C "$repo" rev-list --count origin/main..main 2>/dev/null || echo 'no remote')"
    echo
  done
  echo "## Hard-won operational facts (across the civilization)"
  for repo in $(jq -r '.forts[].repo' "$REG" 2>/dev/null); do
    [ -f "$repo/fort/remember.md" ] && { echo "### $(basename "$repo")"; grep -E '^- \*\*' "$repo/fort/remember.md" | head -10; echo; }
  done
  echo "## Rulings of record (civilization case law)"
  for repo in $(jq -r '.forts[].repo' "$REG" 2>/dev/null); do
    f="$repo/fort/annals/founding-moot.md"
    [ -f "$f" ] && { echo "### $(basename "$repo")"; sed -n '/^## Rulings of record/,$p' "$f" | head -12; echo; }
  done
  echo "## The handbook"
  echo "The full roster, gates, record locations and command reference were just regenerated at $KIT/civ/CIVILIZATION.md. Read it before acting on any fort; it is current as of this wake. The /civ skill is the same lookup path for any other session."
  echo
  echo "## Design record"
  echo "Full research and design rationale lives in ~/Documents/agent-harness-research/."
  { ls ~/Documents/agent-harness-research/*.md 2>/dev/null || true; } | while read -r f; do echo "- $(basename "$f")"; done
  echo
  echo "## Your own memory"
  [ -f "$CIV/remember.md" ] && cat "$CIV/remember.md"
  echo
  echo "### Previous edicts"
  { ls -t "$CIV/handoffs"/*.md 2>/dev/null || true; } | head -3 | while read -r f; do
    echo "--- $(basename "$f") ---"; head -25 "$f"; echo
  done
} > "$BRIEF"

if [ "${1:-}" = "--brief-only" ]; then echo "$BRIEF"; exit 0; fi

# ------------------------------------------------------------ proclamation ---
# emit.sh resolves its target stream from the CURRENT WORKING DIRECTORY (it walks
# git's common dir so a worktree still appends to its main repo's stream). So a
# cross-fort caller must cd into the fort first: invoking $repo/fort/scripts/emit.sh
# from somewhere else writes into the CALLER's fort, not $repo's. That defect ran
# from the seat's creation until 2026-08-04 and put every edict.begun into fortkit
# (fortkit-nvk) — Proofdelve and Farlantern were never told an edict had begun.
for repo in $(jq -r '.forts[].repo' "$REG" 2>/dev/null); do
  [ -x "$repo/fort/scripts/emit.sh" ] && ( cd "$repo" && ./fort/scripts/emit.sh edict.begun \
    "The Regent wakes: an edict is spoken in the Overseer's name (unmasked, full access)" -a regent ) 2>/dev/null || true
done
echo
# Covenant 8.2/8.3 are enforced mechanically, not by prose, because prose is what
# failed. Reported at every wake and never blocking: a failing record is work for
# the Regent, so refusing to wake it would be exactly the wrong response.
if [ -x "$CIV/scripts/check-ceremony-record.sh" ]; then
  "$CIV/scripts/check-ceremony-record.sh" || echo "  ^^ ceremony records VIOLATE the covenant. This is your first work."
fi
echo
echo "  ╔══════════════════════════════════════════════════════════════════╗"
echo "  ║  THE REGENT WAKES — unmasked, unrestricted, civilization-wide.   ║"
echo "  ║  Every fort has been told. The transcript is being kept.          ║"
echo "  ║  Speak the edict, then let the Regent sleep.                      ║"
echo "  ╚══════════════════════════════════════════════════════════════════╝"
echo

# shellcheck disable=SC2329  # invoked via the EXIT trap below, not by name
cleanup() {
  for repo in $(jq -r '.forts[].repo' "$REG" 2>/dev/null); do
    [ -x "$repo/fort/scripts/emit.sh" ] && ( cd "$repo" && ./fort/scripts/emit.sh edict.ended \
      "The Regent sleeps; the edict is ended" -a regent ) 2>/dev/null || true
  done
  echo
  echo "  The Regent sleeps."
  [ -s "$CIV/transcripts/$stamp.log" ] && echo "  Transcript: $CIV/transcripts/$stamp.log"
  echo "  If this edict should be remembered, write it to $CIV/handoffs/regent-$stamp.md"
  rm -f "${SYSPROMPT:-}" "${RUNNER:-}" 2>/dev/null || true
}
trap cleanup EXIT

cd "$KIT"
# The transcript is captured with script(1), not a pipe. Piping claude to tee
# takes stdout off a tty, which flips it into --print mode and it then refuses
# to start without a prompt argument ("Input must be provided either through
# stdin or as a prompt argument"). script keeps a real pty and still logs.
SYSPROMPT="$(mktemp "${TMPDIR:-/tmp}/regent-sysprompt.XXXXXX")"
RUNNER="$(mktemp "${TMPDIR:-/tmp}/regent-run.XXXXXX")"
{
  cat "$BRIEF"
  cat <<PROTOCOL

You are the Regent of this civilization, invoked by the Overseer (Justin), who is present at the keyboard right now. Read the briefing above: it was generated seconds ago and is current.

Your session protocol, in the tradition of the fort seats:
1. WAKE: you have already been briefed. Say in one or two sentences what state you find the civilization in, then ask what the edict is — unless the Overseer's opening instruction already said.
2. ACT with the least force that solves the problem. Prefer a fort's own machinery (beads, its Mayor, its airlock) over acting directly. Acting directly is what you are FOR, but it is the second choice, not the first.
3. RECORD: anything you change in a fort leaves a record there — a bead, an event via that fort's emit.sh, a commit message that explains itself to a stranger. Never falsify or prune a record; corrections are appended.
4. HANDOFF: before the session ends, write ${CIV}/handoffs/regent-${stamp}.md — what the edict was, what you changed, what you verified (with paths and commands, not adjectives), what you failed at, and what the next Regent should know. Append durable facts to ${CIV}/remember.md.

You are unmasked. There is no technical guard on you, only the Overseer's presence and the record. Behave accordingly.
PROTOCOL
} > "$SYSPROMPT"

{
  echo '#!/bin/bash'
  echo "exec claude --dangerously-skip-permissions --append-system-prompt \"\$(cat '$SYSPROMPT')\" ${1:+\"$1\"}"
} > "$RUNNER"
chmod +x "$RUNNER"

# Transcript capture is best-effort and must never cost interactivity. script(1)
# (util-linux-script) keeps a real pty while logging; where it is absent the
# fallback runs the runner directly. Claude Code keeps its own session transcript
# regardless, under ~/.claude/projects/<sanitized-cwd>/, so the record survives
# either way — the edict events and the handoff are the durable part.
#
# Deliberately NOT exec: exec replaces this shell and takes the EXIT trap with it,
# so cleanup() never ran and no edict.ended was ever emitted by this launcher
# (fortkit-nvk). Running the session as a child costs one process and buys the
# closing half of every edict's record. The child's status is propagated so
# callers still see the session's exit code.
status=0
if command -v script >/dev/null 2>&1; then
  script -q -e -c "$RUNNER" "$CIV/transcripts/$stamp.log" || status=$?
else
  echo "  (no script(1) on this host — Claude Code's own session transcript is the record:"
  echo "   ~/.claude/projects/$(printf '%s' "$KIT" | tr '/' '-')/ )"
  echo
  "$RUNNER" || status=$?
fi
exit "$status"
