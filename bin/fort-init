#!/bin/bash
# fort-init — found a new fort in an existing git repo.
# Extracted 2026-08-04 from the diff of Proofdelve (~/dev/ForgeOs) and Farlantern (~/dev/longburn).
# Usage: fort-init <repo-path> <project-name> "<purpose sentence>" [founding-spec-path]
# Env:   FORT_REGISTRY  path to the civilization registry, default
#                       $HOME/.claude/civilization.json. Set it at a writable
#                       path to found a throwaway fort without touching the
#                       real civilization, which is what the factory's own
#                       verification does — and what a masked seat must do,
#                       since the default path is read-only in a claude mask.
#                       Named here for whoever is PLANNING a founding; the
#                       refusals below name it for whoever has already tripped
#                       (Ilva Trueglass, finding 5b on the fortkit-2twy review).
set -euo pipefail
REPO="$(cd "$1" && pwd)"; PROJECT="$2"; PURPOSE="$3"; SPEC="${4:-"(none yet — the Mayor's first work)"}"
KIT="$(cd "$(dirname "$0")/.." && pwd)"
T="$KIT/templates"
DATE=$(date +%F)
cd "$REPO"
# ===========================================================================
# PRECONDITIONS FIRST, MUTATIONS AFTER (fortkit-2twy, closing fortkit-9ahr and
# fortkit-fg7s and the ordering half of fortkit-byhp).
#
# THE DEFECT THIS BLOCK REPAIRS was one defect wearing three faces: fort-init
# discovered fatal conditions LATE — node absent, an unwritable civilization
# registry, a pre-existing artifact it refuses to overwrite — long after the
# tree, the bd database, the founding events and the registry entry existed.
# `set -euo pipefail` (:5) then aborted mid-founding, and the wreckage is a
# fort that LOOKS founded. That is strictly worse than a refusal: fortkit-fg7s
# records a half-founded fort (complete tree, EMPTY fort/events/) reproducing
# an unrelated bug's symptom for the wrong reason, which nearly shipped a fix
# written against a state no correctly-founded fort is ever in.
#
# THE RULE FOR ANYONE ADDING A CHECK: if it can be decided WITHOUT WRITING
# ANYTHING, it belongs in this block. If it cannot, it belongs after the
# founding emissions and the registry append at the foot of this script, which
# are adjacent and late so that no failure can land between them.
# ===========================================================================
# The hard dependencies, declared. git comes FIRST because the not-a-git-repo
# test below is `git rev-parse` and reports a MISSING GIT as a repo that is not a
# repo — the wrong diagnosis, and cheap to remove (Ilva Trueglass, finding 5a on
# the fortkit-2twy review). bd is used at the first mutation; jq merges the
# permission profile two thirds of the way through and appends the registry at the
# very end, so a missing jq used to abort a founding that had built the whole tree.
for tool in git bd jq; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "fort-init: $tool not found, and it is required to found a fort" >&2
    exit 1
  fi
done
git rev-parse --git-dir >/dev/null 2>&1 || { echo "fort-init: $REPO is not a git repo" >&2; exit 1; }
[ -d fort ] && { echo "fort-init: $REPO already has a fort/" >&2; exit 1; }
# node, checked here rather than at the consolidate step it serves
# (fortkit-9ahr, Ilva Trueglass finding 5 on the fortkit-p5mr.10 review). The
# refusal itself is right and stays; only its POSITION was the defect. It used
# to run after the fort was written into the civilization registry and after
# the seat events were emitted, so a node-less host produced a LOUD PARTIAL
# founding where the older swallowed-failure version had produced a silent bad
# one. The message travels unchanged.
if ! command -v node >/dev/null 2>&1; then
  echo "fort-init: node not found, and it is required to found a fort — fort/memory/current.md is the distilled view injected into every seat at session start, and this fort would be born without it" >&2
  exit 1
fi
# Artifacts this script refuses to overwrite. Each of these refusals used to
# fire from where the file is rendered — after bd init and after most of the
# tree existed — so a repo that already carried one of them was left holding a
# partial fort. `if` rather than `&&`: a false test as the last command of a
# loop body makes the loop return 1 and `set -e` aborts the founding, which is
# the trap already recorded at the seat-roster loop below.
for f in scripts/verify-impl.sh scripts/seat-lint.mjs \
         scripts/digest.sh scripts/quiescent.sh scripts/digest-hook.sh scripts/merge-event-check.sh; do
  if [ -e "$f" ]; then
    echo "fort-init: $REPO/$f already exists - refusing to overwrite it" >&2
    exit 1
  fi
done
# THE CIVILIZATION REGISTRY, RESOLVED AND PROBED BEFORE ANYTHING IS BUILT
# (fortkit-fg7s, measured 2026-08-31 from a masked Mayor session).
# $HOME/.claude/civilization.json is a read-only single-file BIND MOUNT in a
# masked CLAUDE seat (fort/scripts/lib/seat-sandbox.sh:296, inside the `claude)`
# arm), so the append at the foot of this script fails EBUSY rather than EROFS —
# a rename cannot replace a mount point. Re-measured under bwrap 2026-08-31 in
# the same posture: `test -w` on the bound file reads NO while its parent
# directory reads YES, which is exactly what this probe discriminates, and the
# naive `test -w` on the directory alone would have passed.
#
# NOT "EVERY SEAT MASK", AND THE SEAT IT MISSES IS THE SILENT ONE (Ilva
# Trueglass, finding 1 on the fortkit-2twy review; she read it from source and
# could not execute it, so the Regent measured it the same hour). The `codex)`
# arm masks $HOME/.claude as a TMPFS instead, so in a Forge mask the registry is
# ABSENT, its parent IS writable, and every probe below passes cleanly. Measured
# inside a real codex mask: listing empty, registry NO, directory writable YES,
# fort-init exit 0, the fort registered — into a tmpfs that dies with the
# namespace, leaving nothing behind. That is a founding reporting success it has
# not earned, which is this script's own subject, in the one posture the
# preflight cannot detect: an absent registry is indistinguishable from a first
# founding, and REFUSING would break both the first-ever founding and every
# FORT_REGISTRY throwaway the factory's verification depends on. So it is
# announced rather than refused, immediately below.
#
# FORT_REGISTRY IS NAMED IN EVERY REFUSAL BELOW because founding from a masked
# seat is the DEFAULT path and not the exotic one — the founding smoke is a
# Mayor's instrument and the Mayor is always masked. The override existed and
# was documented only in seat-sandbox.sh, which is not where a founder looks.
REG="${FORT_REGISTRY:-$HOME/.claude/civilization.json}"
REG_DIR="$(dirname "$REG")"
if [ -e "$REG" ] && [ ! -f "$REG" ]; then
  echo "fort-init: the civilization registry $REG exists and is not a regular file — set FORT_REGISTRY to a writable path" >&2
  exit 1
fi
if [ -f "$REG" ] && [ ! -w "$REG" ]; then
  echo "fort-init: the civilization registry $REG is not writable — founding from a masked seat hits the read-only bind mount on it. Set FORT_REGISTRY to a writable path (that is what the factory's own verification does) and register the fort by hand afterwards if it belongs in the real civilization." >&2
  exit 1
fi
if [ ! -d "$REG_DIR" ] || [ ! -w "$REG_DIR" ]; then
  echo "fort-init: the civilization registry directory $REG_DIR is missing or not writable, and the registry is written by rename through it. Set FORT_REGISTRY to a writable path." >&2
  exit 1
fi
if [ ! -f "$REG" ]; then
  echo "fort-init: NOTE — there is no civilization registry at $REG, so this founding will mint one. For a real civilization that is a once-ever event. If you did not expect it: check FORT_REGISTRY, and check whether you are inside a Forge seat mask, where \$HOME/.claude is a tmpfs and a registry written there dies with the session." >&2
fi
# ------------------------------- end of the no-mutation block; writes begin here
[ -d .beads ] || bd init

# The colony projection reads this passive export.  Use Beads' built-in
# post-write exporter; do not install a hook under .beads, whose hook trees are
# deliberately masked by the seat sandbox because they execute on the host.
# Keep staging explicit so the founding commit remains path-scoped.
bd config set export.auto true
bd config set export.path issues.jsonl
bd config set export.interval 60s
bd config set export.git-add false
bd export -o .beads/issues.jsonl

mkdir -p fort/{seats,handoffs,annals,events,specs,scripts,telemetry,memory/facts}
touch fort/handoffs/.gitkeep
# ONE SUBSTITUTION LIST, TWO CALLERS (fortkit-0po6). Everything that renders a
# file calls render(); the permission merge further down needs the rendered text
# on stdout rather than in a file, so it calls render_stream(). It kept a sed of
# its OWN until 2026-08-14, and that sed knew only {{REPO_PATH}} — so any token
# added here shipped as a LITERAL into every new fort's .claude/settings.json,
# where a rule containing braces matches nothing and denies nothing. That is the
# fortkit-f3y double-slash class one layer up, failing in the direction where the
# fort believes it is protected. Two seds cannot drift if there is one.
#
# {{HOME}} exists so a deny OUTSIDE the repo can be spelled correctly once
# (Overseer ruling on fortkit-0po6, shape (a); the ~/.codex rule that uses it is
# fortkit-hgbe, the Forge's half). The "no absolute-path denies in the
# templates" reading is fortkit-0po6's MIS-DESCRIPTION of fortkit-4wlz, which
# is open and holds no such decision — 4wlz states a defect in two .ssh/.aws
# lines and asks for a ruling among three options. The fortkit-0po6 ruling
# narrows that reading to {{REPO_PATH}} specifically — the token whose value
# is concatenated after a leading slash, which is what produced the
# double-slash class. It was never about absolutes. Attributing the phrase to
# 4wlz sends a stranger to a bead that does not contain it (fortkit-obva).
# EVERY VALUE BELOW LANDS IN THE REPLACEMENT HALF OF A sed s|...|...|g, where
# three characters are syntax: | ends the expression, & expands to the whole
# match, and \ escapes either. $PURPOSE is FREE TEXT FROM THE COMMAND LINE
# (positional $3) and $REPO/$HOME are paths, so without escaping one keystroke
# at founding mangles EVERY rendered file — the fort would be founded subtly
# wrong rather than failing loudly. Escaped once here rather than trusting the
# caller. Filed under standing order 11 with no observed occurrence
# (fortkit-qfnf); the identical hazard is recorded one layer up at
# scripts/verify-impl.sh:231-234 for the render lint's own pass values.
sed_rhs() { printf '%s' "${1-}" | sed -e 's/[\\&|]/\\&/g' -e ':a' -e 'N' -e '$!ba' -e 's/\n/\\n/g'; }
render_stream() {
  local repo project date home spec purpose banner
  repo=$(sed_rhs "$REPO"); project=$(sed_rhs "$PROJECT"); date=$(sed_rhs "$DATE")
  home=$(sed_rhs "$HOME"); spec=$(sed_rhs "$SPEC"); purpose=$(sed_rhs "$PURPOSE")
  banner=$(sed_rhs "${PROJECT^^} FORT STATUS (moot pending)")
  sed -e "s|{{REPO_PATH}}|$repo|g" -e "s|{{PROJECT}}|$project|g" -e "s|{{DATE}}|$date|g" \
    -e "s|{{HOME}}|$home|g" \
    -e "s|{{FORT_NAME}}|(unnamed — moot pending)|g" -e "s|{{FORT_BANNER}}|$banner|g" \
    -e "s|{{FOUNDING_SPEC}}|$spec|g" -e "s|{{PURPOSE}}|$purpose|g" \
    -e "s|{{EXTRA_GATES}}||g" -e "s|{{EXTRA_ORDERS}}||g" "$1"
}
render() { render_stream "$1" > "$2"; }
render "$T/fort/charter.md" fort/charter.md
# THE SEAT ROSTER — one list, four consumers (fortkit-naju): the seat files and
# launchers here, the permission profiles below, the founding fact, and the
# seat.founded events. Those were four hand-maintained enumerations until
# 2026-08-14, and the Researcher — whose four templates had all shipped — was in
# none of them, so a fort founded today was born without the seat and its own
# audit stream said nothing about it.
#
# SEATS ONLY, NO PERSONHOOD (Overseer ruling, 2026-08-14): no names, no pronouns,
# no personalities. Those belong to the Founding Moot and to the citizens
# themselves; a fort must never inherit another settlement's citizen.
#
# Deriving the roster from the template directories was considered and is worse,
# recorded so nobody re-derives it: templates/fort/scripts/ mixes seat launchers
# with emit/status/verify, and templates/fort/profiles/ holds a profile for only
# some of the seats. Derivation needs a naming convention that does not exist.
# An explicit list is still ONE place, which was the whole objective.
#
# Each artifact is rendered IF ITS TEMPLATE EXISTS — a seat with no boundary
# probe or no profile of its own is normal, and an `if` rather than a `&&` chain
# because a trailing false test under `set -e` would abort the founding.
SEATS=(mayor forge warden researcher)
SEAT_OFFICES=$(IFS=/; echo "${SEATS[*]}")
for s in "${SEATS[@]}"; do
  if [ -f "$T/fort/seats/$s.md" ]; then render "$T/fort/seats/$s.md" "fort/seats/$s.md"; fi
  if [ -f "$T/fort/scripts/$s.sh" ]; then render "$T/fort/scripts/$s.sh" "fort/scripts/$s.sh"; fi
  if [ -f "$T/fort/scripts/probe-$s-boundaries.sh" ]; then
    render "$T/fort/scripts/probe-$s-boundaries.sh" "fort/scripts/probe-$s-boundaries.sh"
  fi
done
for sc in emit status verify; do render "$T/fort/scripts/$sc.sh" "fort/scripts/$sc.sh"; done
mkdir -p fort/scripts/lib
render "$T/fort/scripts/lib/seat-sandbox.sh" fort/scripts/lib/seat-sandbox.sh
# The verifier is a SHIM in fort/scripts and an IMPLEMENTATION out here (Shape B,
# fortkit-6ovg / fortkit-x9ou). fort/scripts is a whole-directory read-only bind
# in every seat mask, so the one tool in that set the fort evolves has to live
# where the Mayor can still rewrite it. Founding a fort without this file leaves
# a shim that exits 70 and verifies nothing — which is exactly how the founding
# smoke test caught the omission when Shape B first landed.
# (the refusal on a pre-existing scripts/verify-impl.sh now runs in the
# no-mutation preflight at the head of this script — fortkit-2twy)
mkdir -p scripts
render "$T/scripts/verify-impl.sh" scripts/verify-impl.sh
chmod +x scripts/verify-impl.sh
# The seat-file lint, beside the verifier that runs it (fortkit-bucl, the Regent
# half of fortkit-e69p). It lints fort/seats/ and the civilization registry, so it
# lives in scripts/ with its subject rather than under fort/memory/ with the memory
# lints — the same reasoning that put each memory lint where it sits.
#
# THIS LINE AND templates/scripts/seat-lint.mjs ARE ONE CHANGE AND MUST NOT BE
# SEPARATED. This line without the file is a cp of nothing; the file and the
# template's verifier step without this line kills every founded fort's verifier at
# its first step. Neither is a state a settlement should be founded in.
# (its pre-existence refusal is in the preflight — fortkit-2twy)
cp "$T/scripts/seat-lint.mjs" scripts/seat-lint.mjs
# The session digest and its gates (fortkit-zj8e.10, adopting ADV-0008 from
# Proofdelve). THE SAME COUPLING THE seat-lint COMMENT ABOVE RECORDS:
# templates/scripts/verify-impl.sh already wires merge-event-check as a stage.
# The template verifier ANNOUNCES A SKIP for that stage while the script is
# absent rather than failing, so a fort founded before these lines is honest
# rather than broken - but it does not get the control until they exist.
# RENDER, not cp: merge-event-check.sh carries {{DATE}} (its audit lower bound,
# so a new fort audits from its founding rather than the epoch) and {{PROJECT}}.
# (these four pre-existence refusals are in the preflight — fortkit-2twy)
for sc in digest quiescent digest-hook merge-event-check; do
  render "$T/scripts/$sc.sh" "scripts/$sc.sh"
  chmod +x "scripts/$sc.sh"
done
mkdir -p fort/profiles
for s in "${SEATS[@]}"; do
  if [ -f "$T/fort/profiles/$s-settings.json" ]; then
    render "$T/fort/profiles/$s-settings.json" "fort/profiles/$s-settings.json"
  fi
done
chmod +x fort/scripts/*.sh
cp "$T/fort/events/README.md" fort/events/README.md

# The advisory answer ledger (fortkit-p5mr.2). Standing order 13 tells every fort to
# record its answer to an advisory in fort/advisories.md — "checked, result,
# decision" — so a fort founded without the file receives a constitutional
# instruction to write to a path it does not have. Founded WITH the mechanism
# rather than taught it later; the first answer just appends a row.
render "$T/fort/advisories.md" fort/advisories.md

# Memory: the facts ledger (docs/specs/memory.md). Since fortkit-xgul.1 a fort is
# founded ON the ledger, not on a flat remember.md. The index generator and the
# schema linter travel with the fort (a ledger with no consolidate step produces
# no current.md); the founding operational facts are written AS ledger facts; and
# fort/remember.md becomes a pointer stub so every fort has the identical shape.
cp "$T/fort/memory/consolidate-memory.mjs" fort/memory/consolidate-memory.mjs
cp "$T/fort/memory/memory-lint.mjs" fort/memory/memory-lint.mjs

cat > fort/remember.md <<'EOF'
# Operational memory — pointer stub

This fort's operational memory is the **facts ledger** at `fort/memory/facts/`
(one fact per file, provenance-pointed). Its deterministic distilled view is
`fort/memory/current.md`, regenerated by `fort/memory/consolidate-memory.mjs`.

This file is a pointer stub kept so a reader who arrives at the old path learns
where truth moved. Do not add operational facts here; add them to the ledger.
EOF

# Founding facts as ledger facts (docs/specs/memory.md 4.1). Tiers per 4.2: the
# codex recipe, the founding orientation, and the no-verifiers warning are core
# (a session that never read them would take a wrong action within its first
# steps); the founding spec is on-demand reference. declared-by is the overseer,
# who founds the fort — no seat exists before the moot.
cat > fort/memory/facts/fort-founded.md <<EOF
---
key: fort-founded
status: active
superseded-by: null
tier: core
scope:
  seats: [all]
  topics: [founding]
provenance:
  source: "founded via fort-init on $DATE"
  declared-by: overseer
  date: $DATE
  origin: trusted
---
This fort was founded via fort-init on $DATE; its fort name is pending the
Founding Moot. Until the moot, actor ids default to the seat offices
($SEAT_OFFICES), never personal names.
EOF
cat > fort/memory/facts/codex-launch-recipe.md <<EOF
---
key: codex-launch-recipe
status: active
superseded-by: null
tier: core
scope:
  seats: [mayor, forge]
  topics: [codex, launchers]
provenance:
  source: "founded via fort-init on $DATE"
  declared-by: overseer
  date: $DATE
  origin: trusted
---
The Codex launch recipe must run from the worktree with a workspace-write
sandbox, stdin redirected from /dev/null (the redirect is mandatory or codex
exec hangs forever), and the worktree pre-trusted:
-c 'projects."<worktree>".trust_level="trusted"' -m <model> "<prompt>" </dev/null
EOF
cat > fort/memory/facts/no-verifiers-yet.md <<EOF
---
key: no-verifiers-yet
status: active
superseded-by: null
tier: core
scope:
  seats: [all]
  topics: [verification, ci]
provenance:
  source: "founded via fort-init on $DATE"
  declared-by: overseer
  date: $DATE
  origin: trusted
---
No verifiers exist yet. Standing up fort/scripts/verify.sh and CI from commit
one is an early bead; until it exists, treat every green as unproven.
EOF
cat > fort/memory/facts/founding-spec.md <<EOF
---
key: founding-spec
status: active
superseded-by: null
tier: on-demand
scope:
  seats: [all]
  topics: [founding, spec]
provenance:
  source: "founded via fort-init on $DATE"
  declared-by: overseer
  date: $DATE
  origin: trusted
---
The founding spec of record is: $SPEC.
EOF

# Permission profile: merge template permissions with any existing settings (preserving bd's hook)
mkdir -p .claude
PERMS=$(render_stream "$T/config/settings-permissions.json")
if [ -f .claude/settings.json ]; then
  jq -s '.[0] * .[1]' .claude/settings.json <(printf '%s' "$PERMS") > .claude/settings.json.new && mv .claude/settings.json.new .claude/settings.json
else
  printf '%s' "$PERMS" > .claude/settings.json
fi

# AGENTS.md / CLAUDE.md fort section
for f in AGENTS.md CLAUDE.md; do
  grep -q "operated by an agent fort" "$f" 2>/dev/null || cat >> "$f" << EOF

## The $PROJECT Fort

This repo is operated by an agent fort of Justin's civilization (registry: ~/.claude/civilization.json). Before any work: read fort/charter.md (gates, standing orders), fort/memory/current.md (distilled view; facts ledger in fort/memory/facts/), your seat file in fort/seats/ (session protocols + handoff schema). Work flows through beads: bd ready, claim atomically, reference bead IDs in commits, close only after verifiers green + review. Emit events via fort/scripts/emit.sh. Hard rules: never read .env*; never git add . ; path-scoped staging only.
EOF
done

# Gitignore. fort/events/*.jsonl is deliberately NOT ignored since cycle 7
# (fortkit-i4y): the event stream is the fort's audit record — tracked, it is
# tamper-evident and rides the offsite backup.
grep -q "^\.env\*" .gitignore 2>/dev/null || printf ".env*\n" >> .gitignore

# THE FOUNDING IS ANNOUNCED FIRST AND REGISTERED SECOND, ADJACENT, WITH NOTHING
# BETWEEN THEM (fortkit-fg7s / fortkit-2twy). These two steps used to sit the
# other way round with the registry write able to fail between them, and the
# order is not arbitrary: A FORT THAT EXISTS IN fort/events/ BUT NOT IN THE
# REGISTRY IS RECOVERABLE BY ONE jq APPEND; a fort in the registry that never
# announced itself is silently half-built, and every consumer that reads the
# registry — the Herald's digest, bin/civ-index, any cross-fort sweep — sees a
# settlement that was never finished. So the cheap-to-repair failure is the one
# placed downstream.
fort/scripts/emit.sh fort.founded "The $PROJECT fort is founded via fort-init" -a overseer
for s in "${SEATS[@]}"; do fort/scripts/emit.sh seat.founded "The ${s^} seat stands empty, awaiting the moot" -s "$s"; done

# Register in the civilization. $REG and $REG_DIR were probed in the preflight,
# so the ordinary masked-seat failure never reaches here. This catch covers the
# residual that probe cannot establish without mutating: a WRITABLE file over
# which rename still fails, which is what a read-write single-file bind mount
# produces. It says which step failed and how to finish by hand, because `set -e`
# on a 340-line founding script otherwise reports nothing about how far it got.
[ -f "$REG" ] || echo '{"civilization":"Justin","forts":[]}' > "$REG"
if ! jq --arg p "$PROJECT" --arg r "$REPO" --arg d "$DATE" \
     '.forts += [{"project":$p,"repo":$r,"founded":$d,"fort_name":null}]' "$REG" > "$REG.new"; then
  rm -f "$REG.new"
  echo "fort-init: could not read or rewrite the civilization registry $REG. The fort tree is built and its founding events are emitted; it is NOT registered. Set FORT_REGISTRY to a writable path, or append the entry by hand." >&2
  exit 1
fi
if ! mv "$REG.new" "$REG"; then
  rm -f "$REG.new"
  echo "fort-init: could not replace the civilization registry $REG (a read-only or single-file bind mount refuses the rename). The fort tree is built and its founding events are emitted; it is NOT registered. Set FORT_REGISTRY to a writable path, or append {\"project\":\"$PROJECT\",\"repo\":\"$REPO\",\"founded\":\"$DATE\",\"fort_name\":null} to .forts by hand." >&2
  exit 1
fi

# Generate the distilled view from the seed ledger (docs/specs/memory.md 6.1).
# A fort born with a ledger but no current.md is a fort born broken; run it after
# the founding events so the view captures them.
#
# THIS USED TO BE A WARNING AND THAT WAS THE DEFECT (fortkit-byhp, Warden finding 4
# on fortkit-8t5u). The consolidate step ran under `||` and downgraded any failure
# to a line on stderr, so a fort could be founded EXIT 0 without its distilled view
# and then start every session blind to its own state while founding reported
# success. An artifact the factory produces and runs unattended, whose failure
# nothing goes red for, is the exact class fortkit-8t5u was filed over.
#
# THE ASSERTION IS ON THE ARTIFACT, NOT ON THE EXIT CODE, and that is deliberate.
# An exit-code check catches a crash and misses a SILENT PARTIAL WRITE, which the
# bead names explicitly. Requiring the file to exist and to be non-trivial catches
# the crash, the missing interpreter and the truncated write with one test. The
# founding smoke makes the same assertion from the outside, which is the half that
# stops this regressing.
# EVERY FAILURE PATH HERE PRINTS A SENTENCE. The first draft of this repair let
# `set -e` abort on the node failure, which exchanged a warning nobody reads for a
# SILENT DEATH — measured: a founding against a crashing consolidate-memory exited 3
# with its last line of output an unrelated `bd` message, and nothing saying why.
# That is not an improvement on the defect. Capture the status, say what happened,
# then assert the artifact, then exit.
#
# `command -v node` USED TO LIVE HERE and now runs in the preflight (fortkit-9ahr).
#
# WHY THIS STEP IS STILL LAST, after the emissions and the registry append, when
# fortkit-2twy asks for those two to be last (a deliberate departure, recorded
# where the next reader hits it): this is the one remaining failure that CANNOT be
# decided without mutating, because it is the outcome of running a generator over
# the tree this founding just built. Somewhere it must sit, and its two candidate
# positions are not symmetric. Before the emissions, a failed consolidate leaves a
# complete tree with an EMPTY fort/events/ and no registry entry — the exact
# fortkit-fg7s wreckage that reproduces other bugs' symptoms for the wrong reason.
# After them, it leaves a fort that announced itself, is registered, is missing
# only its distilled view, refuses to report success, and is repaired by re-running
# one command. The invariant fortkit-2twy actually asks for — that no failure lands
# BETWEEN the announcement and the registration — holds either way.
CONSOLIDATE_STATUS=0
node fort/memory/consolidate-memory.mjs "$REPO" || CONSOLIDATE_STATUS=$?
if [ "$CONSOLIDATE_STATUS" -ne 0 ]; then
  echo "fort-init: consolidate-memory.mjs exited $CONSOLIDATE_STATUS — the distilled view was not generated cleanly" >&2
fi
# NOT `cat f | wc -c`. This script runs under `set -o pipefail`, so a missing file
# makes cat fail, makes the PIPELINE fail, and kills the assignment under `set -e`
# BEFORE the check below can print anything — the silent death again, in the branch
# written to prevent it. Measured, not reasoned: the crash control exited 1 with the
# refusal message absent from the log. Same family as the recorded `grep -q` in a
# pipeline scar. The redirect form never builds a pipeline.
CURRENT_BYTES=$(wc -c < fort/memory/current.md 2>/dev/null || echo 0)
if [ "$CURRENT_BYTES" -lt 200 ]; then
  echo "fort-init: fort/memory/current.md is missing or trivial ($CURRENT_BYTES bytes) — refusing to report a founding that produced no distilled view" >&2
  exit 1
fi
if [ "$CONSOLIDATE_STATUS" -ne 0 ]; then
  echo "fort-init: refusing to report a successful founding after the distilled view failed to generate" >&2
  exit "$CONSOLIDATE_STATUS"
fi

echo ""
echo "fort-init: the $PROJECT fort is founded at $REPO"
echo "Next: (1) commit; (2) hold the Founding Moot (names, pronouns, personalities, fort name — ballot per charter moot law);"
echo "      (3) update charter/seats/banner/registry with moot outcomes; (4) file founding beads; (5) maiden bead, supervised."
