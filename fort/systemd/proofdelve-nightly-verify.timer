# Proofdelve nightly full verify timer (ForgeOs-s1reg). Installed by hand into
# ~/.config/systemd/user/ under the Regent edict of 2026-10-19.
#
# 03:30 on the wall clock, when the Overseer is least likely to be using the
# machine. Persistent, so a night the machine slept runs at the next boot.
#
# TO STOP IT: `systemctl --user disable --now proofdelve-nightly-verify.timer`.
# While it is off, tiered host verifies and reused post-merge passes have no
# backstop: turn FLEET_VERIFY_TIERS and FLEET_VERIFY_REUSE off in fleet.conf too.

[Unit]
Description=Proofdelve nightly full verify -- 03:30

[Timer]
OnCalendar=*-*-* 03:30:00
AccuracySec=5min
Persistent=true

[Install]
WantedBy=timers.target
