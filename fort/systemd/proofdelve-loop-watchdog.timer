# Proofdelve loop watchdog timer (ForgeOs-dycc9). Installed by hand into
# ~/.config/systemd/user/ under the Regent sitting of 2026-11-16.
#
# EVERY 15 MINUTES, ON THE WALL CLOCK. The shortest duration the script watches
# is 60 minutes, so an alert arrives at most 15 minutes late. Persistent, so a
# firing missed while the machine slept runs when it wakes.
#
# THE MAYOR ENABLES NOTHING HERE. The Overseer enables this timer after he has
# seen one test alert (fort/scripts/loop-watchdog.sh --test-alert).
# TO STOP IT: systemctl --user disable --now proofdelve-loop-watchdog.timer

[Unit]
Description=Proofdelve loop watchdog, every 15 minutes

[Timer]
OnCalendar=*:0/15
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
